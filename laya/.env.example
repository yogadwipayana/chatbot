# Salin ke .env (cp .env.example .env && chmod 600 .env), lalu isi.

# Wajib. Bearer token untuk POST /v1/systemone.
# Buat dengan: openssl rand -hex 32
# Nilai yang sama dipakai chatbot-api sebagai JEV_API_KEY.
LAYA_API_KEY=

# --- Opsional: nilai di bawah sama dengan default di docker-compose.yml ---

# Tag/commit repo github.com/NandhaKishorM/laya yang di-build.
# v0.3.22 = main per 2026-09-30 (commit 6d942c92081fbc139e736bbd9ac0023223c29b7f).
LAYA_GIT_REF=v0.3.22

# Port di 127.0.0.1 host (8000 dipakai chatbot-api).
LAYA_HOST_PORT=8001

# Thread torch dan batas CPU container (host punya 10 vCPU, dipakai bersama).
LAYA_THREADS=4
LAYA_CPUS=4

# Batas RAM (juga dipakai sebagai memswap_limit, jadi tanpa swap).
LAYA_MEM_LIMIT=3g

# Isi 1 setelah bobot model sudah terunduh ke volume laya-data.
HF_HUB_OFFLINE=0
